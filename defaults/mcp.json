{
  "mcpServers": {
    "playwriter": {
      "command": "node",
      "args": ["${HOME}/.gmnew/current/pw/bin/playwriter-project"],
      "env": {"PLAYWRITER_TELEMETRY": "0"},
      "ignore": [".playwriter/"],
      "deny": ["reset"],
      "lazy": true,
      "releaseAtRunEnd": false,
      "timeoutMs": 300000,
      "startupTimeoutMs": 600000
    }
  }
}
