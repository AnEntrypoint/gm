{
  "mcpServers": {
    "playwriter": {
      "command": "node",
      "args": ["${HOME}/.gmnew/pw/bin/playwriter-project"],
      "env": {"PLAYWRITER_TELEMETRY": "0"},
      "envDefaults": {
        "PLAYWRITER_BROWSER_PATH": "/usr/bin/chromium",
        "PLAYWRITER_IDLE_MS": "28800000",
        "PLAYWRITER_RESTORE_SESSION": "1",
        "PLAYWRITER_CHROMIUM_ARGS": "[\"--enable-unsafe-webgpu\",\"--enable-features=Vulkan\",\"--use-vulkan=swiftshader\",\"--enable-unsafe-swiftshader\"]"
      },
      "ignore": [".playwriter/"],
      "deny": ["reset"],
      "lazy": true,
      "releaseAtRunEnd": false,
      "timeoutMs": 300000,
      "startupTimeoutMs": 600000
    }
  }
}
