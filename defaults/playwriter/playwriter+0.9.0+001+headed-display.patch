+export function displayStatus(env: NodeJS.ProcessEnv = process.env, platform: NodeJS.Platform = process.platform): { headed: boolean; reason: string } {
+  if (platform !== 'linux') return { headed: true, reason: `${platform} draws to its own display` }
+  if (env.WAYLAND_DISPLAY) return { headed: true, reason: `WAYLAND_DISPLAY is ${env.WAYLAND_DISPLAY}` }
+  if (!env.DISPLAY) return { headed: false, reason: 'no display: DISPLAY and WAYLAND_DISPLAY are unset' }
+  const local = /^:(\d+)/.exec(env.DISPLAY)
+  if (!local) return { headed: true, reason: `DISPLAY ${env.DISPLAY} names a remote display` }
+  const socket = `/tmp/.X11-unix/X${local[1]}`
+  if (!fs.existsSync(socket)) return { headed: false, reason: `no display: DISPLAY ${env.DISPLAY} has no X socket at ${socket}` }
+  return { headed: true, reason: `DISPLAY ${env.DISPLAY} is reachable at ${socket}` }
+}
