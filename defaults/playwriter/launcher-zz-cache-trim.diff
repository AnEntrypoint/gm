+const PROFILE_CACHES = ['Cache', 'Code Cache', 'GPUCache'];
+const CACHE_LIMIT_BYTES = (Number(process.env.PLAYWRITER_CACHE_LIMIT_MB) || 200) * 1048576;
+
+function treeBytes(target) {
+  let total = 0;
+  try {
+    for (const entry of fs.readdirSync(target, { withFileTypes: true })) {
+      const child = path.join(target, entry.name);
+      total += entry.isDirectory() ? treeBytes(child) : fs.statSync(child).size;
+    }
+  } catch {}
+  return total;
+}
+
+function trimProfileCaches(log) {
+  const dirs = PROFILE_CACHES.map((name) => path.join(PROFILE, 'Default', name));
+  const bytes = dirs.reduce((sum, dir) => sum + treeBytes(dir), 0);
+  if (bytes <= CACHE_LIMIT_BYTES) return;
+  for (const dir of dirs) fs.rmSync(dir, { recursive: true, force: true });
+  log(`profile caches were ${Math.round(bytes / 1048576)} MB, over ${Math.round(CACHE_LIMIT_BYTES / 1048576)} MB; removed ${PROFILE_CACHES.join(', ')}`);
+}
