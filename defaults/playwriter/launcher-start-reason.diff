+const START_REASON_CHARS = 600;
+const START_REASON_HEAD_CHARS = 200;
+function startReason(message) {
+  const text = String(message)
+    .replace(/\s+/g, ' ')
+    .split(PROJECT + '/').join('<project>/')
+    .replace(/\b[a-z][a-z0-9+.-]*:\/\/[^\s'"|]+/gi, '<url>')
+    .replace(/(?<![\w>])\/[^\s'"|]+/g, '<path>')
+    .replace(/\b([A-Za-z_-]*(?:KEY|TOKEN|SECRET|PASSWORD|PASSWD|AUTH|COOKIE|CREDENTIAL)[A-Za-z_-]*)\s*[=:]\s*\S+/gi, '$1=<redacted>')
+    .replace(/\bBearer\s+\S+/gi, 'Bearer <redacted>')
+    .replace(/\b[A-Za-z0-9_-]{32,}\b/g, '<token>');
+  if (text.length <= START_REASON_CHARS) return text;
+  return text.slice(0, START_REASON_HEAD_CHARS) + ' ... ' + text.slice(-(START_REASON_CHARS - START_REASON_HEAD_CHARS));
+}
