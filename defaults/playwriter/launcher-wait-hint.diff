 const SCAN_TIME_PATTERN = / \(scan \d+ ms\)/;
+const WAIT_HINT_MS = 5000;
+let waitHinted = false;
+function waitHint(msg) {
+  const code = msg.method === 'tools/call' ? msg.params?.arguments?.code : null;
+  if (waitHinted || typeof code !== 'string') return '';
